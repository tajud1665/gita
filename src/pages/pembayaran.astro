---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---

<Base title="Pembayaran" demoBanner noindex>
  <div class="container-page py-12 lg:py-16">
    <!-- Ditampilkan jika kode tidak ditemukan -->
    <div id="not-found" class="mx-auto max-w-lg py-10 text-center" hidden>
      <span class="mx-auto grid size-14 place-items-center rounded-full bg-navy-50 text-navy-800"><Icon name="info" class="size-7" /></span>
      <h1 class="mt-5 text-2xl font-bold">Pendaftaran tidak ditemukan</h1>
      <p class="mt-2 leading-relaxed">Kode pendaftaran tidak ada di browser ini. Data demo hanya tersimpan di perangkat tempat Anda mendaftar.</p>
      <a href="/daftar" class="btn-primary mt-6">Daftar Program</a>
    </div>

    <div id="payment" hidden>
      <p class="eyebrow">Langkah 2 dari 2</p>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight sm:text-4xl">Selesaikan pembayaran</h1>
      <p class="mt-3 flex items-start gap-2 text-lg">
        <Icon name="clock" class="mt-1 size-5 shrink-0 text-sea-600" />
        <span>Selesaikan dalam 1×24 jam, sebelum <strong class="text-ink" data-deadline></strong>.</span>
      </p>

      <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_22rem]">
        <form id="form-bayar" novalidate>
          <fieldset>
            <legend class="text-lg font-bold text-ink">Pilih metode pembayaran</legend>
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              <label class="group flex cursor-pointer items-center gap-4 rounded-2xl border border-line bg-white p-4 transition-colors hover:border-navy-200 has-[:checked]:border-navy-800 has-[:checked]:bg-navy-50 has-[:focus-visible]:outline-3 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-sea-600">
                <input type="radio" name="method" value="transfer" class="sr-only" />
                <span class="grid size-11 place-items-center rounded-xl bg-sea-50 text-sea-600 group-has-[:checked]:bg-navy-800 group-has-[:checked]:text-white"><Icon name="landmark" class="size-5" /></span>
                <span><span class="block font-semibold text-ink">Transfer Bank</span><span class="block text-sm">Verifikasi manual</span></span>
              </label>
              <label class="group flex cursor-pointer items-center gap-4 rounded-2xl border border-line bg-white p-4 transition-colors hover:border-navy-200 has-[:checked]:border-navy-800 has-[:checked]:bg-navy-50 has-[:focus-visible]:outline-3 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-sea-600">
                <input type="radio" name="method" value="qris" class="sr-only" />
                <span class="grid size-11 place-items-center rounded-xl bg-sea-50 text-sea-600 group-has-[:checked]:bg-navy-800 group-has-[:checked]:text-white"><Icon name="qr-code" class="size-5" /></span>
                <span><span class="block font-semibold text-ink">QRIS</span><span class="block text-sm">Semua bank & e-wallet</span></span>
              </label>
            </div>
            <p id="method-error" class="field-error" role="alert" hidden>Pilih metode pembayaran terlebih dahulu.</p>
          </fieldset>

          <!-- Instruksi transfer -->
          <section id="panel-transfer" class="card mt-6 p-5 sm:p-6" aria-labelledby="h-transfer" hidden>
            <h2 id="h-transfer" class="font-bold">Instruksi transfer bank</h2>
            <dl class="mt-4 divide-y divide-line">
              <div class="flex items-center justify-between gap-4 py-3"><dt>Bank</dt><dd class="font-semibold text-ink">{site.payment.bank}</dd></div>
              <div class="flex items-center justify-between gap-4 py-3">
                <dt>Nomor rekening</dt>
                <dd class="flex items-center gap-2 font-semibold text-ink tabular-nums">{site.payment.accountNumber}
                  <button type="button" class="copy-btn" data-copy={site.payment.accountNumber} aria-label="Salin nomor rekening"><Icon name="copy" class="size-4" /></button>
                </dd>
              </div>
              <div class="flex items-center justify-between gap-4 py-3"><dt>Atas nama</dt><dd class="font-semibold text-ink">{site.payment.accountName}</dd></div>
              <div class="flex items-center justify-between gap-4 py-3">
                <dt>Jumlah transfer</dt>
                <dd class="flex items-center gap-2 text-lg font-bold text-ink tabular-nums"><span data-amount></span>
                  <button type="button" class="copy-btn" data-copy-amount aria-label="Salin jumlah transfer"><Icon name="copy" class="size-4" /></button>
                </dd>
              </div>
              <div class="flex items-center justify-between gap-4 py-3">
                <dt>Berita transfer</dt>
                <dd class="flex items-center gap-2 font-mono font-semibold text-ink"><span data-kode translate="no"></span>
                  <button type="button" class="copy-btn" data-copy-kode aria-label="Salin kode pendaftaran"><Icon name="copy" class="size-4" /></button>
                </dd>
              </div>
            </dl>
            <p class="mt-4 flex gap-2 rounded-xl bg-gold-50 p-3 text-sm text-navy-900"><Icon name="info" class="mt-0.5 size-4 shrink-0" />Tulis kode pendaftaran di berita transfer agar pembayaran mudah dicocokkan.</p>
          </section>

          <!-- Instruksi QRIS -->
          <section id="panel-qris" class="card mt-6 p-5 sm:p-6" aria-labelledby="h-qris" hidden>
            <h2 id="h-qris" class="font-bold">Pindai kode QRIS</h2>
            <div class="mt-5 flex flex-col items-center gap-6 sm:flex-row sm:items-start">
              <figure class="relative shrink-0 rounded-2xl border border-line bg-white p-3">
                <div id="qr" class="size-48" role="img" aria-label="Contoh kode QRIS untuk demo, tidak dapat dipindai"></div>
                <figcaption class="absolute inset-0 grid place-items-center">
                  <span class="-rotate-12 rounded-lg border-2 border-red-700 bg-white/90 px-3 py-1 text-lg font-extrabold tracking-widest text-red-700">CONTOH</span>
                </figcaption>
              </figure>
              <ol class="list-decimal space-y-2 pl-5 leading-relaxed">
                <li>Buka aplikasi m-banking atau e-wallet yang mendukung QRIS.</li>
                <li>Pindai kode QR yang ditampilkan.</li>
                <li>Pastikan nominal <strong class="text-ink" data-amount></strong> lalu konfirmasi.</li>
                <li>Simpan bukti pembayaran Anda.</li>
              </ol>
            </div>
          </section>

          <div class="mt-8 flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-between">
            <a href="/daftar" class="btn-outline"><Icon name="arrow-left" class="size-4" />Ubah pendaftaran</a>
            <button type="submit" class="btn-primary text-base">Saya Sudah Membayar <Icon name="check" class="size-4" /></button>
          </div>
        </form>

        <!-- Ringkasan pesanan -->
        <aside aria-labelledby="h-ringkasan">
          <div class="card sticky top-24 overflow-hidden">
            <div class="bg-navy-800 p-5 text-white">
              <h2 id="h-ringkasan" class="text-sm font-medium text-navy-100">Kode pendaftaran</h2>
              <p class="mt-1 flex items-center gap-2 font-mono text-xl font-bold">
                <span data-kode translate="no"></span>
                <button type="button" class="copy-btn text-white! hover:bg-white/10!" data-copy-kode aria-label="Salin kode pendaftaran"><Icon name="copy" class="size-4" /></button>
              </p>
            </div>
            <dl class="space-y-3 p-5 text-[0.95rem]">
              <div><dt class="text-sm">Program</dt><dd class="font-semibold text-ink" data-program></dd></div>
              <div><dt class="text-sm">Pilihan</dt><dd class="font-semibold text-ink" data-offer></dd></div>
              <div><dt class="text-sm">Nama peserta</dt><dd class="font-semibold text-ink" data-nama></dd></div>
              <div class="flex items-end justify-between border-t border-line pt-4">
                <dt class="font-semibold text-ink">Total</dt>
                <dd class="text-2xl font-extrabold text-ink tabular-nums" data-amount></dd>
              </div>
            </dl>
          </div>
        </aside>
      </div>
    </div>
    <p class="sr-only" aria-live="polite" id="live"></p>
  </div>
</Base>

<script>
  import { getProgram, formatRupiah } from '../data/programs';
  import { find, update, type PaymentMethod } from '../scripts/store';
  import { site } from '../data/site';

  const kode = new URLSearchParams(location.search).get('kode');
  const reg = find(kode);
  const program = reg && getProgram(reg.programSlug);

  if (!reg || !program) {
    document.getElementById('not-found')!.hidden = false;
  } else if (reg.status !== 'menunggu_pembayaran') {
    location.replace(`/bukti?kode=${encodeURIComponent(reg.kode)}`);
  } else {
    document.getElementById('payment')!.hidden = false;
    const fill = (sel: string, text: string) => document.querySelectorAll(sel).forEach((el) => (el.textContent = text));
    fill('[data-kode]', reg.kode);
    fill('[data-amount]', formatRupiah(reg.amount));
    fill('[data-program]', program.name);
    fill('[data-nama]', reg.nama);
    fill('[data-offer]', reg.offerId === 'paket' ? reg.offerLabel : `Pelatihan satuan: ${reg.offerLabel}`);
    const deadline = new Date(new Date(reg.createdAt).getTime() + site.payment.deadlineHours * 3600_000);
    fill('[data-deadline]', new Intl.DateTimeFormat('id-ID', { dateStyle: 'full', timeStyle: 'short' }).format(deadline));
    document.querySelectorAll<HTMLElement>('[data-copy-kode]').forEach((b) => (b.dataset.copy = reg.kode));
    document.querySelectorAll<HTMLElement>('[data-copy-amount]').forEach((b) => (b.dataset.copy = String(reg.amount)));
    renderQr(document.getElementById('qr')!, reg.kode);

    const form = document.getElementById('form-bayar') as HTMLFormElement;
    const panels: Record<PaymentMethod, HTMLElement> = {
      transfer: document.getElementById('panel-transfer')!,
      qris: document.getElementById('panel-qris')!,
    };
    form.querySelectorAll<HTMLInputElement>('input[name="method"]').forEach((r) =>
      r.addEventListener('change', () => {
        (Object.keys(panels) as PaymentMethod[]).forEach((m) => (panels[m].hidden = m !== r.value));
        document.getElementById('method-error')!.hidden = true;
      }),
    );

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const method = new FormData(form).get('method') as PaymentMethod | null;
      if (!method) {
        document.getElementById('method-error')!.hidden = false;
        form.querySelector<HTMLInputElement>('input[name="method"]')!.focus();
        return;
      }
      update(reg.kode, { status: 'menunggu_verifikasi', method, paidAt: new Date().toISOString() });
      location.href = `/bukti?kode=${encodeURIComponent(reg.kode)}`;
    });
  }

  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-copy]');
    if (!btn) return;
    try {
      await navigator.clipboard.writeText(btn.dataset.copy!);
      document.getElementById('live')!.textContent = 'Disalin ke clipboard.';
      btn.classList.add('bg-sea-50');
      setTimeout(() => btn.classList.remove('bg-sea-50'), 1200);
    } catch {
      document.getElementById('live')!.textContent = 'Gagal menyalin. Salin secara manual.';
    }
  });

  /** Pola mirip QR (bukan QR sungguhan) — hanya ilustrasi untuk demo. */
  function renderQr(el: HTMLElement, seed: string) {
    const n = 25;
    let h = 2166136261;
    for (const c of seed) h = Math.imul(h ^ c.charCodeAt(0), 16777619);
    const rand = () => ((h = Math.imul(h ^ (h >>> 15), 2246822507) ^ Math.imul(h ^ (h >>> 13), 3266489909)) >>> 0) / 4294967296;
    const finder = (x: number, y: number) =>
      [[0, 0], [n - 7, 0], [0, n - 7]].some(([fx, fy]) => x >= fx && x < fx + 7 && y >= fy && y < fy + 7);
    const finderOn = (x: number, y: number) => {
      const lx = x < 7 ? x : x - (n - 7);
      const ly = y < 7 ? y : y - (n - 7);
      return lx === 0 || lx === 6 || ly === 0 || ly === 6 || (lx >= 2 && lx <= 4 && ly >= 2 && ly <= 4);
    };
    let rects = '';
    for (let y = 0; y < n; y++)
      for (let x = 0; x < n; x++) {
        const on = finder(x, y) ? finderOn(x, y) : rand() > 0.5;
        if (on) rects += `<rect x="${x}" y="${y}" width="1" height="1"/>`;
      }
    el.innerHTML = `<svg viewBox="0 0 ${n} ${n}" class="size-full" fill="#0a2349" shape-rendering="crispEdges" aria-hidden="true">${rects}</svg>`;
  }
</script>
